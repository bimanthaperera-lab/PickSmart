<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Window theme only; the app is drawn by Compose (ui/theme/Theme.kt). -->
    <style name="Theme.Picksmart" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/off_white</item>
        <!-- Android 12+ system splash: background only. The app's own splash shows the logo. -->
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>
    </style>
</resources>
