<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config">

        <!-- Debug-only screen-read feasibility probe (docs/decisions.md, 2026-10-24). Not in release builds. -->
        <service
            android:name="lk.picksmart.probe.ScreenReadProbeService"
            android:exported="true"
            android:label="@string/probe_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screen_read_probe" />
        </service>

        <!-- Debug only: a made-up offer card for checking the offer reader without a ride app. -->
        <activity
            android:name="lk.picksmart.sample.SampleOfferActivity"
            android:exported="true"
            android:theme="@style/Theme.Picksmart" />

    </application>

</manifest>
