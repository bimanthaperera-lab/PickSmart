rules_version = '2';

// Picksmart cloud backup (CLAUDE.md section 14). Each rider can read and write only their own
// users/{uid} document and the record collections under it. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // The profile holds only the settings and details the app writes (CloudProfile). Anything
      // else, such as a Premium flag, can't be written by the app, so a rider can't grant it to
      // themselves.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['mobileNumber', 'activeVehicleSyncId', 'gender', 'birthDate'])
        && (!('mobileNumber' in request.resource.data) || request.resource.data.mobileNumber is string)
        && (!('activeVehicleSyncId' in request.resource.data) || request.resource.data.activeVehicleSyncId is string)
        && (!('gender' in request.resource.data) || request.resource.data.gender in ['MALE', 'FEMALE', 'OTHER', 'PREFER_NOT_TO_SAY'])
        && (!('birthDate' in request.resource.data) || request.resource.data.birthDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));

      // The photo the rider chose: one small JPEG (the app keeps it at 512 px a side).
      match /profile/photo {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['jpeg'])
          && request.resource.data.jpeg is bytes
          && request.resource.data.jpeg.size() <= 1000000;
      }

      match /{kind}/{syncId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && kind in ['vehicles', 'trips', 'other_income', 'fuel_logs', 'expenses']
          && request.resource.data.updatedAt is int
          && request.resource.data.deleted is bool;
      }
    }

    // Premium (CLAUDE.md section 15, Phase 8d): written only by the Cloud Function that verifies
    // the Play purchase (the Admin SDK ignores these rules). The rider can read their own.
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
