<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. The language file is only written below Android 13. data_spaces.xml says
     which database belongs to which account (DataSpaces.kt). Keep in sync with data_extraction_rules.xml. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="datastore/" />
    <include domain="sharedpref" path="app_language.xml" />
    <include domain="sharedpref" path="data_spaces.xml" />
</full-backup-content>
