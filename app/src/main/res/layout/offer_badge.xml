<?xml version="1.0" encoding="utf-8"?>
<!--
    The offer reader's result (CLAUDE.md section 9b), drawn over the ride app in a top corner. Always
    dark, like the app's dark theme, because it sits on top of another app. The band has a label and
    an icon, never colour alone.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_offer_badge"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/offer_badge_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/offer_badge_band"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offer_badge_amounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/off_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offer_badge_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/off_white"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/offer_badge_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/badge_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/offer_badge_powered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:text="@string/offer_badge_powered"
            android:textColor="@color/badge_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
